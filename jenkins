pipeline {
    agent any
    tools{
        jdk 'jdk21'
        maven 'maven3'
    }

    stages {
        stage('Git Checkout') {
            steps {
              git branch: 'main', credentialsId: 'jenkins pipeline authentication ', url: 'https://github.com/DevHub-spring/TaskManagement.git'
            }
        }
         stage('Maven Compile') {
            steps {
                bat 'mvn clean compile'
            }
        }
        stage('OWASP Scan Dependency Check') {
            steps {
                dependencyCheck additionalArguments: ' --scan ./',odcInstallation: 'DP'
                    dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
            }
        }
        stage('Build Application'){
            steps{
                bat 'mvn clean install'
            }
        }
        stage('Build Image & Push Docker Hub'){
            steps{
                script{
                    withDockerRegistry(credentialsId: 'docker', toolName: 'docker') {
                        bat 'docker build -t taskmanagement:latest -f docker/Dockerfile .'
                        bat 'docker tag taskmanagement:latest saikrishna2320/taskmanagement:latest'
                        bat 'docker push saikrishna2320/taskmanagement:latest'
                    }
                }
            }
        }
    }
}
